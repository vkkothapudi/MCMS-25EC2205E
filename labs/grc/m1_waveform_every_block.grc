options:
    parameters:
        author: ''
        catch_exceptions: 'True'
        category: '[GRC Hier Blocks]'
        cmake_opt: ''
        comment: ''
        copyright: ''
        description: ''
        gen_cmake: 'On'
        gen_linking: dynamic
        generate_options: qt_gui
        hier_block_src_path: '.:'
        id: m1_waveform_every_block
        max_nouts: '0'
        output_language: python
        placement: (0,0)
        qt_qss_theme: ''
        realtime_scheduling: ''
        run: 'True'
        run_command: '{python} -u {filename}'
        run_options: prompt
        sizing_mode: fixed
        thread_safe_setters: ''
        title: 'M1: Analog communication system, the waveform at every block'
        window_size: (1400,900)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
blocks:
-   name: alpha
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 1,0,1,2
        label: '"Channel attenuation alpha"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0.005'
        step: '0.005'
        stop: '1'
        value: '0.05'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 670
        - 12
        state: enabled
-   name: fc
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 0,0,1,2
        label: '"Carrier frequency fc (Hz)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '6000'
        step: '500'
        stop: '16000'
        value: '10000'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 330
        - 12
        state: enabled
-   name: mu
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 0,2,1,2
        label: '"Modulation index mu"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0.1'
        step: '0.05'
        stop: '1.5'
        value: '0.75'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 500
        - 12
        state: enabled
-   name: noise_amp
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 1,2,1,2
        label: '"Noise amplitude (V)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0'
        step: '0.001'
        stop: '0.05'
        value: '0.002'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 840
        - 12
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: '48000'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 200
        - 12
        state: enabled
-   name: volume
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 2,0,1,2
        label: '"Loudspeaker volume"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0'
        step: '0.05'
        stop: '1'
        value: '0.3'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1010
        - 12
        state: enabled
