options:
    parameters:
        author: ''
        catch_exceptions: 'True'
        category: '[GRC Hier Blocks]'
        cmake_opt: ''
        comment: ''
        copyright: ''
        description: ''
        gen_cmake: 'On'
        gen_linking: dynamic
        generate_options: qt_gui
        hier_block_src_path: '.:'
        id: m1_comm_system
        max_nouts: '0'
        output_language: python
        placement: (0,0)
        qt_qss_theme: ''
        realtime_scheduling: ''
        run: 'True'
        run_command: '{python} -u {filename}'
        run_options: prompt
        sizing_mode: fixed
        thread_safe_setters: ''
        title: 'M1: One message, end to end (AM, DSB-SC, FM, PM)'
        window_size: (1500,950)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        state: enabled
blocks:
-   name: BT
    id: variable
    parameters:
        comment: ''
        value: '[2*fmax, 2*fmax, 2*(df + fmax), 2*(kp + 1)*fmax][mod]'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 294
        state: enabled
-   name: Pm
    id: variable
    parameters:
        comment: ''
        value: 0.5*(1 + 0.25*two)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 232
        state: enabled
-   name: Ps
    id: variable
    parameters:
        comment: ''
        value: '[(1 + mu**2*Pm)/2, Pm/2, 0.5, 0.5][mod]'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 356
        state: enabled
-   name: alpha
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 2,0,1,1
        label: '"Channel attenuation alpha"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0.1'
        step: '0.05'
        stop: '1'
        value: '0.5'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1760
        - 12
        state: enabled
-   name: df
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 1,1,1,1
        label: '"FM deviation df (Hz)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '250'
        step: '250'
        stop: '5000'
        value: '2500'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1220
        - 12
        state: enabled
-   name: fc
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 0,3,1,1
        label: '"Carrier frequency fc (Hz)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '6000'
        step: '500'
        stop: '20000'
        value: '10000'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 860
        - 12
        state: enabled
-   name: fm
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 0,2,1,1
        label: '"Message frequency fm (Hz)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '250'
        step: '250'
        stop: '3000'
        value: '1000'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 680
        - 12
        state: enabled
-   name: fmax
    id: variable
    parameters:
        comment: ''
        value: fm*(3 if two else 1)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 170
        state: enabled
-   name: kp
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 1,2,1,1
        label: '"PM sensitivity kp (rad)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0.2'
        step: '0.1'
        stop: '2.5'
        value: '1.5'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1400
        - 12
        state: enabled
-   name: mod
    id: variable_qtgui_chooser
    parameters:
        comment: ''
        gui_hint: 0,0,1,1
        label: '"Modulation"'
        label0: '"AM"'
        label1: '"DSB-SC"'
        label2: '"FM"'
        label3: '"PM"'
        label4: ''
        labels: '[]'
        num_opts: '4'
        option0: '0'
        option1: '1'
        option2: '2'
        option3: '3'
        option4: '4'
        options: '[0, 1, 2]'
        orient: Qt.QVBoxLayout
        type: int
        value: '0'
        widget: combo_box
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 330
        - 12
        state: enabled
-   name: mu
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 1,0,1,1
        label: '"AM index mu"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0.1'
        step: '0.05'
        stop: '1.5'
        value: '0.6'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1040
        - 12
        state: enabled
-   name: nbp
    id: variable
    parameters:
        comment: ''
        value: int(53*samp_rate/(22.0*fm))//2*2 + 1
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 480
        state: enabled
-   name: phi
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 1,3,1,1
        label: '"LO phase error phi (deg)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '0'
        step: '5'
        stop: '90'
        value: '0'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1580
        - 12
        state: enabled
-   name: rx_delay
    id: variable
    parameters:
        comment: ''
        value: (nbp - 1)/2 + 64
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 542
        state: enabled
-   name: samp_rate
    id: variable
    parameters:
        comment: ''
        value: 200e3
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 200
        - 12
        state: enabled
-   name: sigma
    id: variable
    parameters:
        comment: ''
        value: alpha*(Ps*(samp_rate/2)/(BT*10**(snr/10)))**0.5
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 418
        state: enabled
-   name: snr
    id: variable_qtgui_range
    parameters:
        comment: ''
        gui_hint: 2,1,1,1
        label: '"Channel SNR in B_T (dB)"'
        min_len: '200'
        orient: QtCore.Qt.Horizontal
        rangeType: float
        start: '-5'
        step: '1'
        stop: '40'
        value: '20'
        widget: counter_slider
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1940
        - 12
        state: enabled
-   name: two
    id: variable_qtgui_chooser
    parameters:
        comment: ''
        gui_hint: 0,1,1,1
        label: '"Message"'
        label0: '"Single tone"'
        label1: '"Two tones (fm and 3fm)"'
        label2: ''
        label3: ''
        label4: ''
        labels: '[]'
        num_opts: '2'
        option0: '0'
        option1: '1'
        option2: '2'
        option3: '3'
        option4: '4'
        options: '[0, 1, 2]'
        orient: Qt.QVBoxLayout
        type: int
        value: '0'
        widget: combo_box
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 500
        - 12
        state: enabled
-   name: w_rx
    id: variable
    parameters:
        comment: ''
        value: '[3.14159/(2*alpha*mu)*(mod == 0), (mod == 1)/alpha, 1.0*(mod == 2),
            (mod == 3)/kp]'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 666
        state: enabled
-   name: w_tx
    id: variable
    parameters:
        comment: ''
        value: '[1.0*(mod == k) for k in range(4)]'
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 1900
        - 604
        state: enabled
