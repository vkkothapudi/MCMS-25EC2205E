  id: analog_sig_source_x
  parameters: {comment: '', type: float, waveform: '[analog.GR_COS_WAVE, analog.GR_TRI_WAVE][wave]', freq: fmsg, amp: amp, offset: 'off', samp_rate: samp_rate, phase: '0', showports: 'False'}
  states:
