    bus_source: false
    bus_structure: null
    coordinate: [450, 300]
    rotation: 0
    state: enabled
- name: analog_frequency_modulator_fc_0
  id: analog_frequency_modulator_fc
  parameters: {comment: '', sensitivity: 2*math.pi*kf/samp_rate}
