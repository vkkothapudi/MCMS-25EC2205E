options:
  parameters: {author: MCMS 25EC2205E, catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: '', copyright: '', description: '', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui,
    hier_block_src_path: '.:', id: p3b_pm_vs_fm, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}',
    run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: 'P3B: PM vs FM - same message, two modulators', window_size: '(1400,900)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {comment: '', value: 64e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [220, 12]
    rotation: 0
    state: enabled
- name: kf
  id: variable
  parameters: {comment: '', value: 5e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [220, 100]
    rotation: 0
    state: enabled
- name: amp
  id: variable
  parameters: {comment: '', value: 2 if wave == 1 else 1}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [370, 12]
    rotation: 0
    state: enabled
- name: 'off'
  id: variable
  parameters: {comment: '', value: -1 if wave == 1 else 0}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [370, 100]
    rotation: 0
    state: enabled
- name: wave
  id: variable_qtgui_chooser
  parameters: {comment: '', label: '"Message"', type: int, value: '0', num_opts: '2', option0: '0', label0: '"Cosine"', option1: '1', label1: '"Triangle"', widget: combo_box, orient: Qt.QHBoxLayout, gui_hint: '0,0,1,1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 12]
    rotation: 0
    state: enabled
- name: fmsg
  id: variable_qtgui_range
  parameters: {comment: '', gui_hint: '0,1,1,1', label: '"Message frequency fm (Hz)"', min_len: '200', orient: QtCore.Qt.Horizontal, rangeType: float, start: '250', step: '50', stop: '4000', value: '1000',
    widget: counter_slider}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [780, 12]
    rotation: 0
    state: enabled
- name: kp
  id: variable_qtgui_range
  parameters: {comment: '', gui_hint: '1,0,1,1', label: '"PM sensitivity kp (rad/V)"', min_len: '200', orient: QtCore.Qt.Horizontal, rangeType: float, start: '0.1', step: '0.05', stop: '4', value: '2',
    widget: counter_slider}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1010, 12]
    rotation: 0
    state: enabled
- name: dpm
  id: variable_qtgui_label
  parameters: {comment: '', formatter: 'lambda x: f"{x:.4f}"', gui_hint: '1,1,1,1', label: '"PM theory: peak df = kp*fm (kHz), tone"', type: real, value: kp*fmsg/1e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 12]
    rotation: 0
    state: enabled
