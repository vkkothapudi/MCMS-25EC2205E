    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters: {comment: '', name: '"Discriminator output: instantaneous frequency (kHz)"', size: '320', ymin: '-7', ymax: '7', nconnections: '1', gui_hint: '3,0,1,2', label1: '"f_i(t) - f_c (kHz)"', type: float,
    srate: samp_rate, autoscale: 'False', axislabels: 'True', ctrlpanel: 'False', entags: 'True', grid: 'True', legend: 'True', stemplot: 'False', tr_chan: '0', tr_delay: '0', tr_level: '0.0', tr_mode: qtgui.TRIG_MODE_FREE,
