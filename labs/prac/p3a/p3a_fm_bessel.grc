options:
  parameters: {author: MCMS 25EC2205E, catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: '', copyright: '', description: '', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui,
    hier_block_src_path: '.:', id: p3a_fm_bessel, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}',
    run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: 'P3A: FM - Bessel lines, Carson bandwidth and the discriminator', window_size: '(1400,900)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {comment: '', value: 32e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [220, 12]
    rotation: 0
    state: enabled
- name: fm
  id: variable
  parameters: {comment: '', value: 1e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [220, 100]
    rotation: 0
    state: enabled
- name: df
  id: variable
  parameters: {comment: '', value: beta*fm}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [370, 12]
    rotation: 0
    state: enabled
- name: import_0
  id: import
  parameters: {comment: '', imports: from scipy.special import jv}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [370, 100]
    rotation: 0
    state: enabled
- name: beta
  id: variable_qtgui_range
  parameters: {comment: '', gui_hint: '0,0,1,2', label: '"Modulation index beta"', min_len: '200', orient: QtCore.Qt.Horizontal, rangeType: float, start: '0', step: '0.005', stop: '6', value: '1.0', widget: counter_slider}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: j0_th
  id: variable_qtgui_label
  parameters: {comment: '', formatter: 'lambda x: f"{x:.4f}"', gui_hint: '1,0,1,1', label: '"Theory |J0(beta)|"', type: real, value: 'abs(jv(0, beta))'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: carson
  id: variable_qtgui_label
  parameters: {comment: '', formatter: 'lambda x: f"{x:.4f}"', gui_hint: '1,1,1,1', label: '"Carson bandwidth (kHz)"', type: real, value: 2*(df + fm)/1e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [990, 12]
    rotation: 0
    state: enabled
- name: analog_sig_source_x_0
  id: analog_sig_source_x
  parameters: {comment: '', type: float, waveform: analog.GR_COS_WAVE, freq: fm, amp: '1', offset: '0', samp_rate: samp_rate, phase: '0', showports: 'False'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 260]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters: {comment: '', type: float, samples_per_second: samp_rate, vlen: '1', ignoretag: 'True', limit: auto, maximum: '0.1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 284]
    rotation: 0
    state: enabled
- name: analog_frequency_modulator_fc_0
  id: analog_frequency_modulator_fc
  parameters: {comment: '', sensitivity: 2*math.pi*df/samp_rate}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 284]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters: {comment: '', name: '"FM spectrum: carrier + Bessel lines (1 kHz apart)"', ymin: '-80', ymax: '0', nconnections: '1', gui_hint: '2,0,1,2', label1: '"FM signal"', type: complex, fftsize: '4096',
    wintype: window.WIN_BLACKMAN_hARRIS, fc: '0', bw: samp_rate, average: '0.2', axislabels: 'True', autoscale: 'False', ctrlpanel: 'False', fftsize_ctrl: '', freqhalf: 'True', grid: 'True', label: Relative
      Gain, units: dB, update_time: '0.10', showports: 'False', legend: 'True', norm_window: 'False', tr_chan: '0', tr_level: '0.0', tr_mode: qtgui.TRIG_MODE_FREE, tr_tag: '""'}
  states:
